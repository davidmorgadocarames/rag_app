# --- Secrets / environment ---
.env
.env.*
!.env.example
# Master-key recovery candidates (D-2026-09-29-2): they live in ~/.secrag-recovery, never in
# a work tree (the tool refuses one); ignored defensively anyway.
**/.secrag-recovery/
**/candidates
# Backups (T11.2.10): encrypted dumps live outside the repository (backup.sh refuses a work
# tree); the local tombstone export folder holds opaque ids only. Ignored defensively.
*.dump.age
*.dump
.tombstones/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Data / corpus (kept out of git; only .gitkeep tracked) ---
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
data/raw_md/*
!data/raw_md/.gitkeep
data/markdown/*
!data/markdown/.gitkeep
data/chunks/*
!data/chunks/.gitkeep
data/corpus_manifest.json

# --- Eval run output (metrics + golden set / thresholds / baseline are tracked) ---
eval/results.json
eval/benchmark.json
eval/latency_results.json

# --- Vector store / caches / models ---
*.sqlite
*.db
.cache/
.ollama/

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Gate state (seed dump for the isolated gate project; scripts/gate.sh --make-seed) ---
.gate/
