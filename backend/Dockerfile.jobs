# SecRAG slim `jobs` image (T11.2.12): the migration Job (compose `migrate` locally, the Azure
# migration Container Apps Job started by CD) and, from 11.2b/11.2.10, the purge and backup
# Jobs. Build context: ./backend
#
#   rag_app WITHOUT torch/sentence-transformers/models (requirements-jobs.txt, same pins as
#   requirements.txt) + alembic.ini + migrations/; PostgreSQL 16 client from PGDG (pg_dump
#   for backups); age (backup encryption); the Azure Blob client (managed identity).
#
# Settings: Jobs read JobSettings only (DATABASE_URL, ENV) — no JWT_SECRET/DATA_MASTER_KEY.
# The base is pinned by digest (X1: Jobs run the deployed digest; rebuilds are reproducible).
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

ARG PG_MAJOR=16
# PGDG signing key (https://www.postgresql.org/download/linux/debian/), checked by fingerprint.
ARG PGDG_KEY_FPR=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg age; \
    install -d -m 0755 /usr/share/postgresql-common/pgdg; \
    curl -4 -fsSL --retry 3 -o /tmp/pgdg.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc; \
    gpg --show-keys --with-colons /tmp/pgdg.asc | grep -qx "fpr:::::::::${PGDG_KEY_FPR}:"; \
    gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg /tmp/pgdg.asc; \
    rm -f /tmp/pgdg.asc; \
    . /etc/os-release; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends "postgresql-client-${PG_MAJOR}"; \
    apt-get purge -y --auto-remove curl gnupg; \
    rm -rf /var/lib/apt/lists/* /root/.gnupg; \
    pg_dump --version | grep -q "(PostgreSQL) ${PG_MAJOR}\."; \
    age --version

WORKDIR /app

COPY requirements-jobs.txt ./
RUN pip install --no-cache-dir -r requirements-jobs.txt

COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations

ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Never root at run time.
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin secrag
USER 10001

# The migration Job (and the compose one-shot `migrate`). Purge/backup Jobs set their own
# command in their Job definition (deploy/azure/jobs/*.yaml).
CMD ["alembic", "upgrade", "head"]
