# ------------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
# The real `.env` is git-ignored and MUST NEVER be committed.
# ------------------------------------------------------------------------------

# --- Environment: dev | prod (default prod when unset) ---
# Local machines set ENV=dev. With ENV=prod the API refuses to start if any development-only
# feature flag is enabled (fail-closed). Never set ENV=dev on Azure.
ENV=dev

# --- Backend: database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Backend: Ollama / models (only 3 models used across the whole system) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Hub commit of RERANKER_MODEL (full 40-hex hash; a branch/tag is refused). The loader reads
# the cached snapshot offline first and downloads this exact commit only when it is missing.
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# Once the model is cached (first run), HF_HUB_OFFLINE=1 forbids any Hub download.
# HF_HUB_OFFLINE=1

# --- Backend: LLM provider (ollama = local/dev default, azure_openai = cloud) ---
# Only the AZURE_OPENAI_* keys are read when LLM_PROVIDER=azure_openai (see ADR phase 10).
LLM_PROVIDER=ollama
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Backend: retrieval / agent limits ---
TOP_K=20
RERANK_TOP_N=4
MAX_AGENT_STEPS=6
MAX_TOKENS=1024

# --- Backend: rate limiting (token bucket) ---
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1

# --- Backend: auth / security (generate strong random values for real use) ---
JWT_SECRET=
JWT_EXPIRES_MINUTES=30
# Master key that wraps per-user data keys (GDPR crypto-shred).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_MASTER_KEY=

# --- Backend: email verification (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker compose only (root .env) ---
# Ollama as seen from the backend CONTAINER. Default: the native WSL Ollama through
# host.docker.internal; with `--profile ci` use http://ollama:11434. (OLLAMA_HOST above is
# for native runs and is not used by compose.)
CONTAINER_OLLAMA_HOST=http://host.docker.internal:11434
# Optional passwords for the db/roles.sql roles; unset → the role stays NOLOGIN.
SECRAG_PURGER_PASSWORD=
SECRAG_BACKUP_PASSWORD=
