# ------------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
# The real `.env` is git-ignored and MUST NEVER be committed.
# ------------------------------------------------------------------------------

# --- Backend: database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Backend: Ollama / models (only 3 models used across the whole system) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Backend: retrieval / agent limits ---
TOP_K=20
RERANK_TOP_N=4
MAX_AGENT_STEPS=6
MAX_TOKENS=1024

# --- Backend: rate limiting (token bucket) ---
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1

# --- Backend: auth / security (generate strong random values for real use) ---
JWT_SECRET=
JWT_EXPIRES_MINUTES=30

# --- Backend: email verification (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
