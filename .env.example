# ------------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
# The real `.env` is git-ignored and MUST NEVER be committed.
# ------------------------------------------------------------------------------

# --- Environment: dev | prod (default prod when unset) ---
# Local machines set ENV=dev. With ENV=prod the API refuses to start if any development-only
# feature flag is enabled (fail-closed). Never set ENV=dev on Azure.
ENV=dev

# --- Backend: database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Backend: Ollama / models (only 3 models used across the whole system) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=bge-m3
# How long OllamaEmbedder.embed() waits for a response (T11.6b.6, block H) -- the SAME
# setting for /chat and /chat/stream (one shared retrieval path). 170s covers a cold Azure
# backend (~60s) + the embed wait + an answer (~5s) within the ~240s ingress cutoff. Lower
# towards ~100-120s once the slim Ollama image's own cold start is measured on Azure, to
# fail faster on a genuinely stuck warm Ollama.
EMBED_TIMEOUT_SECONDS=170
RERANKER_MODEL=BAAI/bge-reranker-base
# Hub commit of RERANKER_MODEL (full 40-hex hash; a branch/tag is refused). The loader reads
# the cached snapshot offline first and downloads this exact commit only when it is missing.
RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
# Token cap per (query, chunk) pair; 256 is the T11.5.3-adopted value (was 512).
RERANKER_MAX_LENGTH=256
# Dynamic int8 quantization of the reranker's Linear layers (T11.5.3 adopted winner: the
# ONLY config that cleared the CPU latency floor on this repo's measurement machine).
RERANKER_QUANTIZE=true
# Max concurrent CrossEncoder.predict() calls process-wide; extra callers queue (T11.5.1b).
# Accepted gap under real concurrent load until KEDA-based autoscaling (Phase 16.3).
RERANK_CONCURRENCY=2
# Once the model is cached (first run), HF_HUB_OFFLINE=1 forbids any Hub download.
# HF_HUB_OFFLINE=1

# --- Backend: LLM provider (ollama = local/dev default, azure_openai = cloud) ---
# Only the AZURE_OPENAI_* keys are read when LLM_PROVIDER=azure_openai (see ADR phase 10).
LLM_PROVIDER=ollama
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Backend: retrieval / agent limits ---
# 10 is the T11.5.3-adopted value (was 20) -- paired with the reranker settings above.
TOP_K=10
RERANK_TOP_N=4
MAX_AGENT_STEPS=6
MAX_TOKENS=1024
# Ollama context window (num_ctx) for the answer/groundedness calls; must match (guarded by a
# test) since both share one model load in the same Ollama server.
NUM_CTX_ANSWER=8192
NUM_CTX_GROUNDEDNESS=8192

# --- Backend: rate limiting (token bucket) ---
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1

# --- Backend: global daily answer cap (R6-1) ---
# Answers per UTC day for all users together, counted in usage_daily before any LLM call.
# Default 150 (what Azure runs with, D-2026-10-01-1). 0 = off, allowed only with ENV=dev; ENV=prod refuses
# to start without a positive cap. The local compose stack uses 1000 unless this is set.
DAILY_ANSWER_CAP=0

# --- Backend: auth / security (generate strong random values for real use) ---
JWT_SECRET=
JWT_EXPIRES_MINUTES=30
# Master key that wraps per-user data keys (GDPR crypto-shred).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_MASTER_KEY=

# --- Backend: email verification (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker compose only (root .env) ---
# Ollama as seen from the backend CONTAINER. Default: the native WSL Ollama through
# host.docker.internal; with `--profile ci` use http://ollama:11434. (OLLAMA_HOST above is
# for native runs and is not used by compose.)
CONTAINER_OLLAMA_HOST=http://host.docker.internal:11434
# Optional passwords for the db/roles.sql roles; unset → the role stays NOLOGIN.
SECRAG_PURGER_PASSWORD=
SECRAG_BACKUP_PASSWORD=
